{
    "name": "zung/zung-php",
    "description": "PHP client for the Zung Member API: member login, loans, repayment schedules, loan applications, savings and wallets for SACCOs and MFIs on Zung.",
    "type": "library",
    "license": "MIT",
    "keywords": ["zung", "sacco", "mfi", "microfinance", "core-banking", "loans", "savings", "sdk", "api"],
    "homepage": "https://zung.ai",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Zung\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zung\\Tests\\": "php/tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
